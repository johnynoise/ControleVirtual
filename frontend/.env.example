# URL base da API do backend.
#
# Modo servidor único (recomendado para notebook-servidor): o backend serve
# o build do frontend na mesma porta 8000, então deixe em branco ou use
# caminho relativo (o frontend chama a própria origem automaticamente).
# VITE_API_URL=

# Modo desenvolvimento (dois processos, npm run dev na porta 5173):
VITE_API_URL=http://localhost:8000

# Acesso de outros dispositivos pela rede local (ex.: celular), em modo dev,
# troque pelo IP do notebook, ex.:
# VITE_API_URL=http://192.168.3.194:8000
