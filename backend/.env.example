# Banco de dados
# Desenvolvimento local (padrão, sem servidor): SQLite em arquivo.
DATABASE_URL=sqlite:///./controle_virtual.db
# Produção com PostgreSQL (basta trocar a linha acima por esta):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/controle_virtual

# Configurações da aplicação
APP_NAME=ControleVirtual API
APP_ENV=development

# CORS - origens permitidas (frontend). Aceita várias, separadas por vírgula.
# Para acessar de outros dispositivos na mesma rede (celular, outro PC),
# adicione o IP do notebook na rede local, ex.:
#   FRONTEND_ORIGIN=http://localhost:5173,http://192.168.3.194:5173,http://192.168.3.194:8000
FRONTEND_ORIGIN=http://localhost:5173

# Nome da loja exibido no recibo (PDF e email)
LOJA_NOME=ControleVirtual

# Envio de recibo por email (SMTP)
# Deixe em branco para manter o envio de email desabilitado.
# Exemplo com Gmail (use uma "senha de app", não a senha normal da conta):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=sualoja@gmail.com
#   SMTP_PASSWORD=xxxxxxxxxxxxxxxx
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# STARTTLS (porta 587). Para SSL direto (porta 465): SMTP_STARTTLS=false e SMTP_SSL=true
SMTP_STARTTLS=true
SMTP_SSL=false
# Remetente (se vazio, usa SMTP_USER)
EMAIL_REMETENTE=
EMAIL_REMETENTE_NOME=ControleVirtual
